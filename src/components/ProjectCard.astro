---
import type { Project } from "../data/projects";

interface Props {
  project: Project;
}
const { project } = Astro.props;
const { n, kind, title, description, tags, href, mediaLabel } = project;

// Si hay enlace, la tarjeta es un <a>; si no, un <div>.
const Tag = href ? "a" : "div";
---

<Tag
  href={href}
  target={href ? "_blank" : undefined}
  rel={href ? "noopener" : undefined}
  data-tilt
  class="group flex flex-col overflow-hidden border border-line bg-card text-fg transition-[border-color,transform] duration-500 hover:border-acc"
>
  <div class="relative h-52 overflow-hidden bg-card-2">
    <span
      class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 bg-bg px-3 py-2 font-mono text-[10.5px] uppercase tracking-widest text-dim"
    >
      {mediaLabel}
    </span>
  </div>

  <div class="flex flex-col gap-3 p-6.5">
    <span class="font-mono text-[10.5px] uppercase tracking-[0.14em] text-acc"
      >{n} / {kind}</span
    >
    <h3 class="m-0 text-[23px] font-medium tracking-[-0.02em]">{title}</h3>
    <p class="m-0 text-[13.5px] leading-[1.65] text-muted text-pretty">
      {description}
    </p>
    <div
      class="mt-1 flex flex-wrap gap-1.75 font-mono text-[10.5px] text-muted"
    >
      {
        tags.map((t) => (
          <span class="rounded-full border border-line px-2.5 py-1.5">{t}</span>
        ))
      }
    </div>
  </div>
</Tag>
