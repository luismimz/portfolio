---
import { projects } from "../data/projects";
import ProjectCard from "./ProjectCard.astro";
---

<section id="trabajos" class="mx-auto max-w-375 px-7 pb-10 pt-26">
  <div
    data-reveal
    data-stagger
    class="mb-10 flex flex-wrap items-end justify-between gap-7.5"
  >
    <h2
      class="m-0 text-[clamp(30px,4.2vw,58px)] font-medium leading-none tracking-[-0.04em]"
    >
      Webs en producción
    </h2>
    <p class="m-0 max-w-90 text-[14.5px] leading-[1.6] text-muted text-pretty">
      Sitios reales, con clientes reales detrás. Alojados y mantenidos en mi
      VPS.
    </p>
  </div>
  <div
    data-reveal
    data-stagger
    class="grid grid-cols-[repeat(auto-fit,minmax(320px,1fr))] gap-5"
  >
    {projects.map((project) => <ProjectCard project={project} />)}
  </div>
</section>
