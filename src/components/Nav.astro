---
const links = [
  { href: "#top", label: "Inicio" },
  { href: "#trabajos", label: "Trabajos" },
  { href: "#antes-despues", label: "Antes/Después" },
  { href: "#trayectoria", label: "Experiencia" },
  { href: "#formacion", label: "Formación" },
  { href: "#stack", label: "Stack" },
];
---

<nav
  class="fixed inset-x-0 top-0 z-50 flex items-center justify-between gap-5 border-b border-line bg-bg/70 px-4 py-4 backdrop-blur-md md:px-7"
>
  <a data-magnet href="#top" class="flex items-center gap-2.5 text-fg">
    <span class="dot h-2 w-2 rounded-full bg-acc"></span>
    <span class="font-mono text-[12.5px] tracking-wide">luismontalvan.com</span>
  </a>

  <div class="flex items-center gap-5">
    <!-- Links: solo escritorio -->
    <div
      class="hidden items-center gap-5 font-mono text-[11.5px] uppercase tracking-[0.09em] lg:flex"
    >
      {
        links.map((l) => (
          <a
            href={l.href}
            data-navlink={l.href.slice(1)}
            class="text-muted transition-colors hover:text-fg data-[active=true]:text-fg"
          >
            {l.label}
          </a>
        ))
      }
    </div>

    <!-- Interruptor de tema: SIEMPRE visible -->
    <div
      class="flex items-center gap-0.5 rounded-full border border-line p-0.75"
    >
      <button
        type="button"
        data-set-theme="light"
        title="Modo claro"
        aria-label="Modo claro"
        class="grid h-5.75 w-7.5 place-items-center rounded-full text-xs text-muted data-[active=true]:bg-acc data-[active=true]:text-ink"
        >☀</button
      >
      <button
        type="button"
        data-set-theme="system"
        title="Según el sistema"
        aria-label="Modo según el sistema"
        class="grid h-5.75 w-7.5 place-items-center rounded-full font-mono text-[9.5px] text-muted data-[active=true]:bg-acc data-[active=true]:text-ink"
        >AUTO</button
      >
      <button
        type="button"
        data-set-theme="dark"
        title="Modo oscuro"
        aria-label="Modo oscuro"
        class="grid h-5.75 w-7.5 place-items-center rounded-full text-xs text-muted data-[active=true]:bg-acc data-[active=true]:text-ink"
        >☾</button
      >
    </div>

    <!-- Contacto: solo escritorio (en móvil está en el dock) -->
    <a
      data-magnet
      href="#contacto"
      class="hidden rounded-full border border-acc px-4 py-2 text-acc transition-colors hover:bg-acc hover:text-ink lg:inline-block"
    >
      Contacto
    </a>
  </div>

  <div
    data-progress
    class="absolute inset-x-0 -bottom-px h-0.5 origin-left scale-x-0 bg-acc"
  >
  </div>
</nav>

<style>
  .dot {
    animation: blink 2.6s steps(1) infinite;
  }
</style>
<script>
  //Barra de proceso de scroll
  const bar = document.querySelector<HTMLElement>("[data-progress]");
  const onScroll = () => {
    const el = document.documentElement;
    const max = el.scrollHeight - el.clientHeight;
    const ratio = max > 0 ? el.scrollTop / max : 0;
    if (bar) bar.style.transform = `scaleX(${ratio})`;
  };
  document.addEventListener("scroll", onScroll, { passive: true });
  onScroll();
  //Link activo según la seccion visible
  const navlinks = [
    ...document.querySelectorAll<HTMLAnchorElement>("[data-navlink]"),
  ];
  const linkById = new Map(navlinks.map((a) => [a.dataset.navlink, a]));
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        navlinks.forEach((a) => (a.dataset.active = "false"));
        const active = linkById.get(entry.target.id);
        if (active) active.dataset.active = "true";
      }
    },
    { rootMargin: "-40% 0px -55% 0px" },
  );
  document.querySelectorAll("section[id]").forEach((s) => observer.observe(s));
  // ---- Cambio de tema ----
  const root = document.documentElement;
  const THEME_KEY = "lmm-theme";

  const currentTheme = () => {
    try {
      return localStorage.getItem(THEME_KEY) ?? "system";
    } catch {
      return "system";
    }
  };

  const applyTheme = (mode: string) => {
    if (mode === "light" || mode === "dark") {
      root.dataset.theme = mode;
    } else {
      delete root.dataset.theme; // "system": sin atributo
    }
    try {
      localStorage.setItem(THEME_KEY, mode);
    } catch {}

    // botón activo
    document.querySelectorAll<HTMLElement>("[data-set-theme]").forEach((b) => {
      b.dataset.active = String(b.dataset.setTheme === mode);
    });

    // avisa a quien pinte con los colores (el canvas del Hero)
    window.dispatchEvent(new CustomEvent("themechange"));
  };

  document
    .querySelectorAll<HTMLButtonElement>("[data-set-theme]")
    .forEach((b) => {
      b.addEventListener("click", () => applyTheme(b.dataset.setTheme!));
    });

  applyTheme(currentTheme()); // sincroniza el switch al cargar
</script>
