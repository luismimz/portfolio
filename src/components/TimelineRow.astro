---
import type { TimelineEntry } from "../data/experience";

interface Props {
  entry: TimelineEntry;
  accent?: boolean;
}
const { entry, accent = false } = Astro.props;
const { meta, title, org, text, href } = entry;
---

<div
  class="grid grid-cols-[158px_1fr] gap-7 border-t border-line py-7 max-sm:grid-cols-1 max-sm:gap-2"
>
  <div
    class:list={[
      "pt-1.5 font-mono text-[11.5px] tracking-[0.08em]",
      accent ? "text-acc" : "text-dim",
    ]}
  >
    {
      href ? (
        <a href={href} target="_blank" rel="noopener" class="text-acc">
          {meta}
        </a>
      ) : (
        meta
      )
    }
  </div>

  <div class="flex flex-col gap-2.5">
    <h3 class="m-0 text-[22px] font-medium tracking-[-0.02em]">
      {title}
      {org && <span class="text-muted"> · {org}</span>}
    </h3>
    {
      text && (
        <p class="m-0 max-w-165 text-[14.5px] leading-[1.65] text-muted text-pretty">
          {text}
        </p>
      )
    }
  </div>
</div>
